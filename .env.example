# Database Connection
DATABASE_URL="file:./dev.db"

# Server Port & Secrets
PORT=4000
NODE_ENV="development"
JWT_SECRET="your-super-secret-jwt-key"

# Client Web App URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Tournament & Registration Fee
TOURNAMENT_NAME="Mini IPL Cricket Tournament 2026"
REGISTRATION_FEE=108

# Commercial Cashfree Payment Gateway (merchant.cashfree.com)
CASHFREE_APP_ID="YOUR_CASHFREE_APP_ID"
CASHFREE_SECRET_KEY="YOUR_CASHFREE_SECRET_KEY"
CASHFREE_ENVIRONMENT="sandbox" # "sandbox" or "production"
CASHFREE_WEBHOOK_SECRET="YOUR_CASHFREE_SECRET_KEY"

# Official Meta Cloud WhatsApp API
WHATSAPP_PROVIDER="META_CLOUD"
WHATSAPP_BUSINESS_NUMBER="9791234315"
WHATSAPP_PHONE_NUMBER_ID="YOUR_META_PHONE_NUMBER_ID"
WHATSAPP_API_TOKEN="YOUR_META_PERMANENT_ACCESS_TOKEN"
WHATSAPP_TEMPLATE_NAME="player_registration_success"

# Supabase PostgreSQL & Storage Configuration
# DATABASE_URL: Pooler connection string e.g. postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: Direct connection string e.g. postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL="YOUR_SUPABASE_POSTGRESQL_URL"
DIRECT_URL="YOUR_SUPABASE_DIRECT_URL"

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET_PUBLIC="player-photos"
SUPABASE_STORAGE_BUCKET_PRIVATE="player-documents"
